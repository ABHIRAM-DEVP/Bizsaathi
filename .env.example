# Copy to .env and provide values locally. Never commit .env or expose server values to NEXT_PUBLIC_*.
APP_NAME=BizSaathi API
APP_ENV=development
JWT_SECRET=
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Optional: owner credentials for Alembic when POSTGRES_USER does not own existing tables.
MIGRATION_DATABASE_USER=
MIGRATION_DATABASE_PASSWORD=
POSTGRES_PORT=5433
API_PORT=8080
FRONTEND_PORT=3000
REDIS_URL=
REDIS_PORT=6379
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEV_BUSINESS_NAME=Demo Store
DEV_BUSINESS_SLUG=demo-store
LOW_STOCK_THRESHOLD=5

# S3-compatible storage. Start the optional Compose service with --profile storage after registry access is verified.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
MEDIA_STORAGE_PATH=
OBJECT_STORAGE_BUCKET=bizsaathi-media
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
SIGNED_URL_TTL_SECONDS=300
MINIO_API_PORT=
MINIO_CONSOLE_PORT=

# Model credentials remain server-side. Mock mode makes no external model calls.
MODEL_PROVIDER=mock
MODEL_MOCK_MODE=true
REASONING_API_KEY=
MODEL_API_BASE_URL=http://localhost
# For live mode set MODEL_PROVIDER=live and MODEL_MOCK_MODE=false; use the provider's model ID, never the API key.
REASONING_MODEL=mock
MODEL_REQUEST_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2

# Browser-safe API endpoint and explicitly local demo identity only. Never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_DEMO_ACCOUNT=demo-owner
NEXT_PUBLIC_DEMO_BUSINESS_NAME=Demo Store
NEXT_PUBLIC_DEMO_OWNER_NAME=Local owner
